# SearXNG configuration for local AI agent use
# Docs: https://docs.searxng.org/admin/settings/
#
# Copy this file to settings.yml and generate a unique secret key:
#   cp searxng/settings.yml.example searxng/settings.yml
#   python -c "import secrets; print(secrets.token_hex(32))"

use_default_settings: true

server:
  # IMPORTANT: Generate a unique key before using
  secret_key: "CHANGE_ME_generate_with_python_secrets_token_hex_32"
  limiter: false  # Disable rate limiting for local use
  image_proxy: false  # Not needed for text search

# Force IPv4 to avoid Google blocking IPv6
outgoing:
  source_ips:
    - 0.0.0.0

search:
  safe_search: 0  # Disable safe search for job searches
  default_lang: en
  formats:
    - html
    - json  # Required for API access

# Enable engines that actually work
# Google/Bing often blocked, DuckDuckGo times out
engines:
  # Working engines (tested)
  - name: brave
    disabled: false
    weight: 1.5
  - name: startpage
    disabled: false
    weight: 1.3
  - name: qwant
    disabled: false
    weight: 1.0

  # Try Google with longer timeout
  - name: google
    disabled: false
    weight: 1.2
    timeout: 6.0

  # Disable broken engines
  - name: duckduckgo
    disabled: true  # Constant timeouts
  - name: bing
    disabled: true  # Returns garbage results

  # Disable less relevant engines
  - name: wikidata
    disabled: true
  - name: wikipedia
    disabled: true
