# LLM Provider: "local", "anthropic", or "openai"
LLM_PROVIDER=local

# Local model (Ollama)
LOCAL_MODEL=gpt-oss:120b
OLLAMA_URL=http://localhost:11434

# API fallbacks (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# External services
EXA_API_KEY=

# PostgreSQL for LangGraph Store (persistent memory)
DATABASE_URL=postgresql://langraph:langraph@localhost:5432/langraph

# Langfuse Tracing (self-hosted at ../langfuse)
# Get keys from http://localhost:3000 -> Project Settings
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://localhost:3000
