# AI Agents Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# LLM Configuration
# =============================================================================

# Local model name (must be pulled in Ollama first)
LOCAL_MODEL=gpt-oss:120b

# Ollama API URL (default works with docker-compose setup)
OLLAMA_URL=http://localhost:11434

# =============================================================================
# Web Search (SearXNG)
# =============================================================================

# SearXNG host URL (default works with docker-compose setup)
SEARXNG_HOST=http://localhost:8080

# =============================================================================
# Observability (Optional)
# =============================================================================

# Langfuse tracing - get keys from https://langfuse.com or self-host
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_HOST=http://localhost:3000

# =============================================================================
# Database (Optional)
# =============================================================================

# PostgreSQL for LangGraph Store (if using persistent checkpoints)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langraph
